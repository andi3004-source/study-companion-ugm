# Laravel Cloud template: paste into the environment's variables in the
# Laravel Cloud dashboard, fill in the empty values, and never commit the result.
# See README "Deploy ke Laravel Cloud". Keep values plain (no ${...} references).

APP_NAME="TUTURNUSA"
APP_ENV=staging
# Generate once: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# https:// + the domain Laravel Cloud gives you (or your own domain)
APP_URL=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Behind the Laravel Cloud proxy: trust its X-Forwarded-* headers and always build https:// URLs.
TRUSTED_PROXIES=*
APP_FORCE_HTTPS=true

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MySQL 8 (attach a MySQL database to the environment; Laravel Cloud fills in
# DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD). Kamus search has
# MySQL and SQLite variants only, so do not pick Postgres.
DB_CONNECTION=mysql

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
# Above AnalyzeSessionJob's 180-second timeout, so a slow analysis is not run twice.
DB_QUEUE_RETRY_AFTER=200
CACHE_STORE=database
# The app stores no user uploads; the disk is temporary and that is fine.
FILESYSTEM_DISK=local

# Email (verification, password reset). "log" sends nothing; set a real mailer to send.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TUTURNUSA"

# AI. Set a spending limit with each provider before filling these in.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RETRY_MAX=2
GEMINI_RETRY_DELAYS=1,3
GEMINI_RETRY_JITTER_MS=250
GEMINI_RETRY_BUDGET_CHAT=15
GEMINI_RETRY_BUDGET_SCAN=
GEMINI_RETRY_BUDGET_ANALYSIS=120
GEMINI_RETRY_BUDGET_SECONDS=12
GEMINI_FALLBACK_MODELS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LANGFLOW_URL=
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT=120

# Ngobrol messages per user per day (whole number 1-1000; anything else falls back to 50).
DAILY_MESSAGE_LIMIT=50

# The Python pronunciation service cannot run on Laravel Cloud: compare via speech-to-text.
PRONUNCIATION_CHECKER_DRIVER=stt_match

HSK_LEVEL_LOCK=true
SCAN_BENDA_ENABLED=false

# Who may sign up. For a public demo: false, or an invite code (shared privately).
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=

# Demo account (staging only; refused when APP_ENV=production).
DEMO_ACCOUNT_ENABLED=false
DEMO_ACCOUNT_EMAIL=demo@studycompanion.test
DEMO_ACCOUNT_PASSWORD=
