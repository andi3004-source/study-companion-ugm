# Production / staging template for docker-compose.yml (one server).
# Copy to .env ON THE SERVER, fill in the empty values, and never commit it.
# docker compose reads this file both for ${DOMAIN} and as the app's environment.
# Keep values plain (no ${...} references) so docker compose and Laravel read them the same way.

# Public domain name pointing at this server; Caddy gets the HTTPS certificate for it.
DOMAIN=

APP_NAME="TUTURNUSA"
APP_ENV=staging
# Generate once on the server: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
# https:// + DOMAIN
APP_URL=
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Behind the Caddy proxy: trust its X-Forwarded-* headers and always build https:// URLs.
TRUSTED_PROXIES=*
APP_FORCE_HTTPS=true

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite on the shared volume (docker-compose.yml fixes DB_CONNECTION and DB_DATABASE).
# WAL + busy timeout: the web and the queue worker write to the same file.
DB_JOURNAL_MODE=wal
DB_BUSY_TIMEOUT=5000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Email (verification, password reset). "log" sends nothing; set a real mailer to send.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="TUTURNUSA"

# AI. Set a spending limit with each provider before filling these in.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LANGFLOW_URL=
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
LANGFLOW_TIMEOUT=120

# Ngobrol messages per user per day (whole number 1-1000; anything else falls back to 50).
DAILY_MESSAGE_LIMIT=50

# The ML pronunciation service is not part of this compose file: compare via speech-to-text.
PRONUNCIATION_CHECKER_DRIVER=stt_match

HSK_LEVEL_LOCK=true
SCAN_BENDA_ENABLED=false

# Who may sign up. For a public demo: false, or an invite code (shared privately).
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=

# Demo account (staging only; refused when APP_ENV=production).
DEMO_ACCOUNT_ENABLED=false
DEMO_ACCOUNT_EMAIL=demo@studycompanion.test
DEMO_ACCOUNT_PASSWORD=
