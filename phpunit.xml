<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="HSK_CORRECTIONS_PATH" value="" force="true"/>
        <!-- Behaviour-changing app settings are pinned so the local .env never leaks into tests
             (force="true" also overrides variables already set in the process; .env loading never overrides them). -->
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <env name="GEMINI_MODEL" value="gemini-3.6-flash" force="true"/>
        <env name="GEMINI_RETRY_MAX" value="2" force="true"/>
        <env name="GEMINI_RETRY_DELAYS" value="1,3" force="true"/>
        <env name="GEMINI_RETRY_JITTER_MS" value="250" force="true"/>
        <env name="GEMINI_RETRY_BUDGET_SECONDS" value="12" force="true"/>
        <env name="GEMINI_RETRY_BUDGET_CHAT" value="15" force="true"/>
        <env name="GEMINI_RETRY_BUDGET_SCAN" value="" force="true"/>
        <env name="GEMINI_RETRY_BUDGET_ANALYSIS" value="120" force="true"/>
        <env name="GEMINI_FALLBACK_MODELS" value="" force="true"/>
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="ANTHROPIC_MODEL" value="claude-haiku-4-5-20251001" force="true"/>
        <env name="LANGFLOW_URL" value="" force="true"/>
        <env name="LANGFLOW_FLOW_ID" value="" force="true"/>
        <env name="LANGFLOW_API_KEY" value="" force="true"/>
        <env name="LANGFLOW_TIMEOUT" value="120" force="true"/>
        <env name="PRONUNCIATION_SERVICE_URL" value="http://localhost:8001" force="true"/>
        <env name="PRONUNCIATION_CHECKER_DRIVER" value="ml" force="true"/>
        <env name="HSK_LEVEL_LOCK" value="true" force="true"/>
        <env name="DEMO_ACCOUNT_ENABLED" value="false" force="true"/>
        <env name="DEMO_ACCOUNT_EMAIL" value="demo@studycompanion.test" force="true"/>
        <env name="DEMO_ACCOUNT_PASSWORD" value="" force="true"/>
        <env name="DAILY_MESSAGE_LIMIT" value="50" force="true"/>
        <env name="REGISTRATION_ENABLED" value="true" force="true"/>
        <env name="REGISTRATION_INVITE_CODE" value="" force="true"/>
        <env name="GAME_ITEMS_PATH" value="" force="true"/>
        <env name="KATABICARA_PATH" value="storage/app/seed-data/daftar_benda_tertutup.json" force="true"/>
        <env name="SCAN_BENDA_ENABLED" value="false" force="true"/>
        <env name="SCAN_BENDA_MAX_IMAGE_BYTES" value="4000000" force="true"/>
        <env name="SCAN_BENDA_RATE_LIMIT_PER_MINUTE" value="6" force="true"/>
        <env name="SCAN_BENDA_TIMEOUT" value="30" force="true"/>
        <!-- Same values as $_SERVER: Laravel reads $_SERVER before $_ENV, so both are pinned. -->
        <server name="HSK_CORRECTIONS_PATH" value="" force="true"/>
        <server name="GEMINI_API_KEY" value="" force="true"/>
        <server name="GEMINI_MODEL" value="gemini-3.6-flash" force="true"/>
        <server name="GEMINI_RETRY_MAX" value="2" force="true"/>
        <server name="GEMINI_RETRY_DELAYS" value="1,3" force="true"/>
        <server name="GEMINI_RETRY_JITTER_MS" value="250" force="true"/>
        <server name="GEMINI_RETRY_BUDGET_SECONDS" value="12" force="true"/>
        <server name="GEMINI_RETRY_BUDGET_CHAT" value="15" force="true"/>
        <server name="GEMINI_RETRY_BUDGET_SCAN" value="" force="true"/>
        <server name="GEMINI_RETRY_BUDGET_ANALYSIS" value="120" force="true"/>
        <server name="GEMINI_FALLBACK_MODELS" value="" force="true"/>
        <server name="ANTHROPIC_API_KEY" value="" force="true"/>
        <server name="ANTHROPIC_MODEL" value="claude-haiku-4-5-20251001" force="true"/>
        <server name="LANGFLOW_URL" value="" force="true"/>
        <server name="LANGFLOW_FLOW_ID" value="" force="true"/>
        <server name="LANGFLOW_API_KEY" value="" force="true"/>
        <server name="LANGFLOW_TIMEOUT" value="120" force="true"/>
        <server name="PRONUNCIATION_SERVICE_URL" value="http://localhost:8001" force="true"/>
        <server name="PRONUNCIATION_CHECKER_DRIVER" value="ml" force="true"/>
        <server name="HSK_LEVEL_LOCK" value="true" force="true"/>
        <server name="DEMO_ACCOUNT_ENABLED" value="false" force="true"/>
        <server name="DEMO_ACCOUNT_EMAIL" value="demo@studycompanion.test" force="true"/>
        <server name="DEMO_ACCOUNT_PASSWORD" value="" force="true"/>
        <server name="GAME_ITEMS_PATH" value="" force="true"/>
        <server name="KATABICARA_PATH" value="storage/app/seed-data/daftar_benda_tertutup.json" force="true"/>
        <server name="SCAN_BENDA_ENABLED" value="false" force="true"/>
        <server name="SCAN_BENDA_MAX_IMAGE_BYTES" value="4000000" force="true"/>
        <server name="SCAN_BENDA_RATE_LIMIT_PER_MINUTE" value="6" force="true"/>
        <server name="SCAN_BENDA_TIMEOUT" value="30" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
